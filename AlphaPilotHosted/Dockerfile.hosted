FROM python:3.11-slim AS api
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt
COPY app ./app

FROM debian:12-slim
WORKDIR /
RUN apt-get update && apt-get install -y --no-install-recommends nginx supervisor python3 ca-certificates && rm -rf /var/lib/apt/lists/*
COPY --from=api /usr/local /usr/local
COPY --from=api /app /app
COPY frontend /var/www/html
COPY infra/nginx.plain.conf /etc/nginx/nginx.conf
COPY infra/supervisord.conf /etc/supervisor/conf.d/supervisord.conf
ENV PORT=8080
RUN sed -i 's/listen 80;/listen 8080;/g' /etc/nginx/nginx.conf || true
EXPOSE 8080
CMD ["/usr/bin/supervisord","-n"]
