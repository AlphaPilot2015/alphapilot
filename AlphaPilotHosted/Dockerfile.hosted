# ===== API build (Python) =====
FROM python:3.11-slim AS api
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt
COPY app ./app

# ===== Runner con Nginx + Supervisord =====
FROM debian:12-slim
WORKDIR /
# gettext-base trae 'envsubst' (para inyectar $PORT en nginx)
RUN apt-get update && apt-get install -y --no-install-recommends \
      nginx supervisor python3 ca-certificates gettext-base \
    && rm -rf /var/lib/apt/lists/*

# Copiamos runtime Python y la app
COPY --from=api /usr/local /usr/local
COPY --from=api /app /app

# Frontend estático
COPY frontend /var/www/html

# Configs: plantilla de nginx que usa ${PORT} y supervisord
COPY infra/nginx.tmpl.conf /etc/nginx/nginx.tmpl.conf
COPY infra/supervisord.conf /etc/supervisor/conf.d/supervisord.conf

# Script de arranque (compatible con /bin/sh; no requiere bash)
RUN printf '%s\n' '#!/usr/bin/env sh' \
    'set -e' \
    ': "${PORT:=8080}"' \
    'envsubst < /etc/nginx/nginx.tmpl.conf > /etc/nginx/nginx.conf' \
    'exec /usr/bin/supervisord -n' > /start.sh \
 && chmod +x /start.sh

# Render inyecta PORT; no hace falta EXPOSE
CMD ["/start.sh"]
