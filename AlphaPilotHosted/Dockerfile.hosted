# -------- stage: api --------
FROM python:3.11-slim-bookworm AS api
WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY app ./app

# -------- stage: final --------
FROM debian:bookworm-slim
WORKDIR /
RUN apt-get update && apt-get install -y --no-install-recommends \
    nginx supervisor python3 ca-certificates gettext-base \
 && rm -rf /var/lib/apt/lists/*

# copy python runtime/libs from api stage
COPY --from=api /usr/local /usr/local
COPY --from=api /app /app

# frontend + configs
COPY frontend /var/www/html
COPY infra/nginx.tmpl.conf /etc/nginx/nginx.tmpl.conf
COPY infra/supervisord.conf /etc/supervisor/conf.d/supervisord.conf
COPY start.sh /start.sh
RUN chmod +x /start.sh

ENV PORT=8080
EXPOSE 8080
CMD ["/start.sh"]
