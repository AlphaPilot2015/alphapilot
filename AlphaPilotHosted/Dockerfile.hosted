# ===== API build (Python) =====
FROM python:3.11-slim AS api
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt
COPY app ./app

# ===== Runner con Nginx + Supervisord =====
FROM debian:12-slim
WORKDIR /
# gettext-base trae 'envsubst' para inyectar $PORT en la conf de nginx
RUN apt-get update && apt-get install -y --no-install-recommends nginx supervisor python3 ca-certificates gettext-base \
  && rm -rf /var/lib/apt/lists/*

# Copiamos runtime Python y la app
COPY --from=api /usr/local /usr/local
COPY --from=api /app /app

# Frontend estático
COPY frontend /var/www/html

# Configs: usamos plantilla que referencia ${PORT}
COPY infra/nginx.tmpl.conf /etc/nginx/nginx.tmpl.conf
COPY infra/supervisord.conf /etc/supervisor/conf.d/supervisord.conf

# Script de arranque: genera nginx.conf con el $PORT que da Render y lanza supervisord
RUN bash -lc 'cat > /start.sh << "SH"\n\
#!/usr/bin/env bash\n\
set -e\n\
: "${PORT:=8080}"\n\
envsubst < /etc/nginx/nginx.tmpl.conf > /etc/nginx/nginx.conf\n\
exec /usr/bin/supervisord -n\n\
SH\n\
chmod +x /start.sh'

# Render inyecta PORT automáticamente; no fijamos EXPOSE
CMD ["/start.sh"]
