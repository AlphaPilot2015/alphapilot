# ===== API build (Python) =====
FROM python:3.11-slim AS api
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt
COPY app ./app

# ===== Runner (MISMA BASE: python:3.11-slim) =====
FROM python:3.11-slim
WORKDIR /
# gettext-base trae 'envsubst'
RUN apt-get update && apt-get install -y --no-install-recommends \
      nginx supervisor ca-certificates gettext-base \
    && rm -rf /var/lib/apt/lists/*

# Copiamos runtime y la app desde el stage api
COPY --from=api /usr/local /usr/local
COPY --from=api /app /app

# Frontend estático
COPY frontend /var/www/html

# Configs plantilla + supervisord
COPY infra/nginx.tmpl.conf /etc/nginx/nginx.tmpl.conf
COPY infra/supervisord.conf /etc/supervisor/conf.d/supervisord.conf

# Script de arranque: SOLO sustituye ${PORT} (no toca $host/$scheme)
RUN printf '%s\n' '#!/usr/bin/env sh' \
    'set -e' \
    ': "${PORT:=8080}"' \
    'envsubst '\''${PORT}'\'' < /etc/nginx/nginx.tmpl.conf > /etc/nginx/nginx.conf' \
    'exec /usr/bin/supervisord -n' > /start.sh \
 && chmod +x /start.sh

CMD ["/start.sh"]
